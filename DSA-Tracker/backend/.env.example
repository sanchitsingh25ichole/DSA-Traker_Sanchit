# Server Configuration
PORT=5000

# MongoDB Database Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/dsa_tracker
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dsa_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dsa_tracker

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
